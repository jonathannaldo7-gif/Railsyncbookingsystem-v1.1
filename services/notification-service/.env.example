APP_NAME="RailSync Notification Service"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8005
SERVICE_NAME=notification-service

REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis

LOG_CHANNEL=stack

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=notifications@railsync.com
MAIL_FROM_NAME="RailSync Notifications"

AUTH_SERVICE_URL=http://auth-app:8000
BOOKING_SERVICE_URL=http://booking-app:8000
