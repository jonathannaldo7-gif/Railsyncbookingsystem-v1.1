APP_NAME="RailSync Auth Service"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001
SERVICE_NAME=auth-service

DB_CONNECTION=mysql
DB_HOST=auth-mysql
DB_PORT=3306
DB_DATABASE=railsync_auth
DB_USERNAME=railsync
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

LOG_CHANNEL=stack

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=auth@railsync.com
MAIL_FROM_NAME="RailSync Auth"
