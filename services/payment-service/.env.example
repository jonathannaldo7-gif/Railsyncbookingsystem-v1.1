APP_NAME="RailSync Payment Service"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8004
SERVICE_NAME=payment-service

DB_CONNECTION=mysql
DB_HOST=payment-mysql
DB_PORT=3306
DB_DATABASE=railsync_payment
DB_USERNAME=railsync
DB_PASSWORD=secret

REDIS_HOST=redis
